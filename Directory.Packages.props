<Project>
  <!-- Central package management. Versions checked against nuget.org on 2026-11-26. -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
    <PackageVersion Include="Npgsql" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
  </ItemGroup>
  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <!-- Tests run on Microsoft.Testing.Platform (opted in via global.json), not VSTest. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
  </ItemGroup>
  <!-- EF Core targets only the newest runtime of each major version, so pick the major per TFM. -->
  <ItemGroup Label="EF Core (net10.0)" Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
  </ItemGroup>
  <ItemGroup Label="EF Core (net11.0)" Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
  </ItemGroup>
</Project>
