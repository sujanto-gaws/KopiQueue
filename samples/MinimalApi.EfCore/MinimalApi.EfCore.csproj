<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A minimal API that saves orders with EF Core and inserts their jobs in the same transaction, on PostgreSQL or SQL
       Server. See README.md. -->
  <PropertyGroup>
    <RootNamespace>KopiQueue.Samples.MinimalApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KopiQueue.EntityFrameworkCore\KopiQueue.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\KopiQueue.Hosting\KopiQueue.Hosting.csproj" />
    <ProjectReference Include="..\..\src\KopiQueue.Npgsql\KopiQueue.Npgsql.csproj" />
    <ProjectReference Include="..\..\src\KopiQueue.SqlServer\KopiQueue.SqlServer.csproj" />
  </ItemGroup>

</Project>
