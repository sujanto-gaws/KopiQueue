<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Source-generated configuration binding: no reflection, so trimmed and Native AOT apps can bind (NFR-COMP-06). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <Description>Generic Host integration for KopiQueue: AddKopiQueue(), hosted service, configuration binding, health checks.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KopiQueue\KopiQueue.csproj" />
  </ItemGroup>

</Project>
