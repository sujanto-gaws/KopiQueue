<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQL Server and Azure SQL driver for KopiQueue (Microsoft.Data.SqlClient).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KopiQueue\KopiQueue.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- KopiQueue's own migration line "main" for SQL Server (design §4.4, plan task 5.1). -->
    <EmbeddedResource Include="Migrations\**\*.sql" LogicalName="kopi-migrations/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The executor's statements (design §8.1), rendered once per driver for its schema and prefix. -->
    <EmbeddedResource Include="Sql\*.sql" LogicalName="kopi-sql/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
