<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>PostgreSQL driver for KopiQueue (River-compatible schema, LISTEN/NOTIFY, COPY).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KopiQueue\KopiQueue.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- River-compatible migration line "main" (design §4.1, plan task 1.2). -->
    <EmbeddedResource Include="Migrations\**\*.sql" LogicalName="kopi-migrations/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Driver statements (design §8). -->
    <EmbeddedResource Include="Sql\*.sql" LogicalName="kopi-sql/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
